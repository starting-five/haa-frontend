{
  "private": true,
  "name": "haa-frontend",
  "version": "0.1.1-rc3",
  "engines": {
    "node": ">=26.11.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "check:dynamic-api-routes": "node scripts/check-dynamic-api-routes.mjs",
    "build:release": "NEXT_PUBLIC_FRONTEND_SHA=$(git rev-parse HEAD) next build --webpack",
    "start": "next start",
    "lint": "eslint src e2e compatibility scripts next.config.ts playwright.config.ts playwright.staging.config.ts vitest.config.mts vitest.compatibility.config.mts vitest.postdeployment.config.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/components src/lib/__tests__",
    "test:watch": "vitest",
    "test:integration": "vitest run src/services/__tests__/*.integration.test.ts",
    "test:contract": "vitest run src/contracts/__tests__/*.contract.test.ts",
    "test:compatibility": "vitest run --config vitest.compatibility.config.mts",
    "test:release-metadata": "vitest run src/release/__tests__/release-metadata.test.ts",
    "test:version": "vitest run src/release/__tests__/app-version.test.ts src/lib/__tests__/build-info.test.ts src/app/api/version",
    "format": "prettier --write src",
    "test:e2e": "playwright test",
    "test:e2e:staging": "playwright test --config playwright.staging.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "sha": "git rev-parse HEAD",
    "version:print": "node scripts/print-app-version.mjs",
    "version:build-tag": "node scripts/print-build-tag.mjs",
    "smoke:frontend": "node scripts/frontend-smoke.mjs",
    "smoke:deployment": "node scripts/deployment-smoke.mjs",
    "compatibility:run": "node scripts/run-compatibility.mjs",
    "dub:purge-domain-links": "node scripts/purge-dub-domain-links.mjs",
    "generate:release-record": "node scripts/generate-release-record.mjs",
    "verify:postdeploy": "vitest run --config vitest.postdeployment.config.mts",
    "validate:release": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:contract && npm run test:release-metadata && npm run test:version && npm run build",
    "validate:staging": "npm run smoke:deployment && npm run test:e2e:staging && npm run compatibility:run",
    "validate:env": "node -e \"const url = process.env.NEXT_PUBLIC_API_URL; if (!url || url === 'http://localhost:4000') { console.error('ERROR: NEXT_PUBLIC_API_URL must be set to a staging or production URL (got: ' + url + ')'); process.exit(1); } console.log('NEXT_PUBLIC_API_URL validated:', url)\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.545.0",
    "next": "latest",
    "next-intl": "^4.13.6",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.438.9",
    "posthog-node": "^5.55.3",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-dropzone": "^20.1.0",
    "react-phone-number-input": "^3.4.18",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
